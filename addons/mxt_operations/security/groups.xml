<odoo>
    <record id="category_lab" model="ir.module.category"><field name="name">Manufacturing Reconstruction</field><field name="sequence">45</field></record>
    <record id="group_procurement_user" model="res.groups"><field name="name">Procurement User</field><field name="category_id" ref="category_lab"/><field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/></record>
    <record id="group_procurement_manager" model="res.groups"><field name="name">Procurement Manager</field><field name="category_id" ref="category_lab"/><field name="implied_ids" eval="[(4, ref('group_procurement_user')), (4, ref('purchase.group_purchase_manager'))]"/></record>
    <record id="group_final_approver" model="res.groups"><field name="name">Final Purchase Approver</field><field name="category_id" ref="category_lab"/><field name="implied_ids" eval="[(4, ref('group_procurement_user'))]"/></record>
    <record id="group_warehouse_operator" model="res.groups"><field name="name">Warehouse Operator</field><field name="category_id" ref="category_lab"/><field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/></record>
    <record id="group_warehouse_manager" model="res.groups"><field name="name">Warehouse Manager</field><field name="category_id" ref="category_lab"/><field name="implied_ids" eval="[(4, ref('group_warehouse_operator')), (4, ref('stock.group_stock_manager'))]"/></record>
    <record id="group_manufacturing_operator" model="res.groups"><field name="name">Manufacturing Operator</field><field name="category_id" ref="category_lab"/><field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/></record>
    <record id="group_production_supervisor" model="res.groups"><field name="name">Production Supervisor</field><field name="category_id" ref="category_lab"/><field name="implied_ids" eval="[(4, ref('group_manufacturing_operator')), (4, ref('mrp.group_mrp_manager'))]"/></record>
    <record id="group_quality_reviewer" model="res.groups"><field name="name">Quality Reviewer</field><field name="category_id" ref="category_lab"/><field name="implied_ids" eval="[(4, ref('group_manufacturing_operator'))]"/></record>
    <record id="group_planning_manager" model="res.groups"><field name="name">Material Planning Manager</field><field name="category_id" ref="category_lab"/><field name="implied_ids" eval="[(4, ref('group_warehouse_manager')), (4, ref('group_procurement_user')), (4, ref('group_production_supervisor'))]"/></record>
    <record id="base.user_admin" model="res.users"><field name="groups_id" eval="[(4, ref('group_planning_manager')), (4, ref('group_quality_reviewer')), (4, ref('group_procurement_manager')), (4, ref('group_final_approver'))]"/></record>
</odoo>
