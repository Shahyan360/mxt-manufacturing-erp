<odoo noupdate="1">
    <record id="warehouse_raw" model="stock.warehouse"><field name="name">Fictional Raw Materials</field><field name="code">LRAW</field><field name="company_id" ref="base.main_company"/></record>
    <record id="warehouse_supply" model="stock.warehouse"><field name="name">Fictional Secondary Supply</field><field name="code">LSUP</field><field name="company_id" ref="base.main_company"/></record>
    <record id="warehouse_production" model="stock.warehouse"><field name="name">Fictional Production</field><field name="code">LPRD</field><field name="company_id" ref="base.main_company"/><field name="resupply_wh_ids" eval="[(4, ref('warehouse_supply'))]"/></record>
    <record id="warehouse_finished" model="stock.warehouse"><field name="name">Fictional Finished Goods</field><field name="code">LFIN</field><field name="company_id" ref="base.main_company"/></record>
    <record id="vendor" model="res.partner"><field name="name">Example Components Supplier</field><field name="supplier_rank">1</field><field name="email">supplier@example.invalid</field></record>
    <record id="customer" model="res.partner"><field name="name">Example Workshop Customer</field><field name="customer_rank">1</field><field name="email">buyer@example.invalid</field></record>
    <record id="component_a" model="product.product"><field name="name">Demo Steel Panel</field><field name="default_code">LAB-PANEL</field><field name="type">product</field><field name="mxt_material_class">raw</field><field name="mxt_safety_stock">2</field><field name="standard_price">20</field></record>
    <record id="component_b" model="product.product"><field name="name">Demo Fastener Pack</field><field name="default_code">LAB-PACK</field><field name="type">product</field><field name="mxt_material_class">component</field><field name="mxt_safety_stock">1</field><field name="standard_price">5</field></record>
    <record id="finished_product" model="product.product"><field name="name">Demo Utility Cabinet</field><field name="default_code">LAB-CABINET</field><field name="type">product</field><field name="mxt_material_class">finished</field><field name="list_price">300</field><field name="route_ids" eval="[(4, ref('stock.route_warehouse0_mto')), (4, ref('mrp.route_warehouse0_manufacture'))]"/></record>
    <record id="supplier_a" model="product.supplierinfo"><field name="partner_id" ref="vendor"/><field name="product_tmpl_id" model="product.template" eval="obj().env.ref('mxt_operations.component_a').product_tmpl_id.id"/><field name="price">20</field><field name="delay">3</field></record>
    <record id="supplier_b" model="product.supplierinfo"><field name="partner_id" ref="vendor"/><field name="product_tmpl_id" model="product.template" eval="obj().env.ref('mxt_operations.component_b').product_tmpl_id.id"/><field name="price">5</field><field name="delay">2</field></record>
    <record id="cabinet_bom" model="mrp.bom"><field name="product_tmpl_id" model="product.template" eval="obj().env.ref('mxt_operations.finished_product').product_tmpl_id.id"/><field name="product_id" ref="finished_product"/><field name="product_qty">1</field><field name="product_uom_id" ref="uom.product_uom_unit"/><field name="type">normal</field><field name="company_id" ref="base.main_company"/></record>
    <record id="bom_panel" model="mrp.bom.line"><field name="bom_id" ref="cabinet_bom"/><field name="product_id" ref="component_a"/><field name="product_qty">2</field><field name="product_uom_id" ref="uom.product_uom_unit"/></record>
    <record id="bom_pack" model="mrp.bom.line"><field name="bom_id" ref="cabinet_bom"/><field name="product_id" ref="component_b"/><field name="product_qty">1</field><field name="product_uom_id" ref="uom.product_uom_unit"/></record>
    <record id="demo_buyer" model="res.users"><field name="name">Demo Procurement Requester</field><field name="login">lab.buyer</field><field name="email">procurement@example.invalid</field><field name="groups_id" eval="[(6,0,[ref('base.group_user'),ref('group_procurement_user')])]"/></record>
    <record id="demo_manager" model="res.users"><field name="name">Demo Procurement Manager</field><field name="login">lab.manager</field><field name="email">manager@example.invalid</field><field name="groups_id" eval="[(6,0,[ref('base.group_user'),ref('group_procurement_manager')])]"/></record>
    <record id="demo_final" model="res.users"><field name="name">Demo Final Approver</field><field name="login">lab.final</field><field name="email">final@example.invalid</field><field name="groups_id" eval="[(6,0,[ref('base.group_user'),ref('group_final_approver')])]"/></record>
    <record id="demo_operator" model="res.users"><field name="name">Demo Production Operator</field><field name="login">lab.operator</field><field name="email">operator@example.invalid</field><field name="groups_id" eval="[(6,0,[ref('base.group_user'),ref('group_manufacturing_operator')])]"/></record>
    <record id="demo_quality" model="res.users"><field name="name">Demo Quality Reviewer</field><field name="login">lab.quality</field><field name="email">quality@example.invalid</field><field name="groups_id" eval="[(6,0,[ref('base.group_user'),ref('group_quality_reviewer')])]"/></record>
    <function model="mxt.planning.policy" name="_seed_demo"/>
</odoo>
